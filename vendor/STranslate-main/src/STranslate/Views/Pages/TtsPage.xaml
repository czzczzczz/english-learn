<ui:Page
    x:Class="STranslate.Views.Pages.TtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cnvt="clr-namespace:STranslate.Converters"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.ViewModels.Pages"
    Title="Tts"
    d:DataContext="{d:DesignInstance Type=vm:TtsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}"
            Text="{DynamicResource Tts}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <!--  未找到服务提示  -->
                <TextBlock
                    Margin="4,0,0,12"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding Message}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasMessage, Converter={cnvt:BoolToVisibilityConverter}}" />

                <control:CardGroup>
                    <ui:SettingsCard
                        Description="单词（3 个词以内）优先用有道真人录音，更自然"
                        Header="{DynamicResource Tts_WordEngine}"
                        IsEnabled="{Binding IsServiceAvailable}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.BookOpen_20_Regular}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="170"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding WordEngines}"
                            SelectedValue="{Binding WordEngine, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </ui:SettingsCard>

                    <ui:SettingsCard
                        Description="只影响单词朗读，整句用合成音"
                        Header="{DynamicResource Tts_Accent}"
                        IsEnabled="{Binding IsServiceAvailable}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="170"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding Accents}"
                            SelectedValue="{Binding Accent, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </ui:SettingsCard>

                    <ui:SettingsCard
                        Description="整句朗读语速，改完立即生效"
                        Header="{DynamicResource Tts_Speed}"
                        IsEnabled="{Binding IsServiceAvailable}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Timer_20_Regular}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="170"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding Speeds}"
                            SelectedValue="{Binding Speed, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </ui:SettingsCard>
                </control:CardGroup>

                <!--  试听  -->
                <control:CardGroup>
                    <ui:SettingsCard
                        Description="改完参数点一下，直接听效果"
                        Header="{DynamicResource Tts_Preview}"
                        IsEnabled="{Binding IsServiceAvailable}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Speaker2_20_Regular}" />
                        </ui:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                MinWidth="96"
                                Command="{Binding TrySpeakWordCommand}"
                                Content="{DynamicResource Tts_PreviewWord}" />
                            <Button
                                MinWidth="110"
                                Margin="8,0,0,0"
                                Command="{Binding TrySpeakSentenceCommand}"
                                Content="{DynamicResource Tts_PreviewSentence}" />
                        </StackPanel>
                    </ui:SettingsCard>
                </control:CardGroup>

                <!--  说明  -->
                <ContentControl Margin="4,4,0,0" IsTabStop="False">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Tts_SourceNote}"
                        TextWrapping="Wrap" />
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:Page>
