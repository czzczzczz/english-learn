<Window
    x:Class="STranslate.Views.ScreenRegionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    Cursor="Cross"
    ShowInTaskbar="False"
    Title="STranslateRegionOverlay"
    Topmost="True"
    WindowStyle="None"
    WindowState="Normal">

    <!--  用 Canvas 定位：移动时只改附加属性，不触发 Grid 重排，避免尺寸数字闪烁  -->
    <Canvas x:Name="PART_Canvas" ClipToBounds="True">
        <!--  遮罩：整屏半透明，选区用 EvenOdd 挖空  -->
        <Path x:Name="PART_Mask" Fill="#99000000" />

        <!--  选区边框  -->
        <Rectangle
            x:Name="PART_Selection"
            Stroke="#FF4A9EFF"
            StrokeThickness="2"
            Visibility="Collapsed" />

        <!--  选区尺寸提示  -->
        <Border
            x:Name="PART_SizeLabel"
            Padding="8,3"
            Background="#E6000000"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                x:Name="PART_SizeText"
                FontSize="12"
                Foreground="White" />
        </Border>

        <!--  操作提示  -->
        <Border
            x:Name="PART_Hint"
            Padding="14,8"
            Background="#E6000000"
            CornerRadius="6">
            <TextBlock
                FontSize="13"
                Foreground="White"
                Text="按住左键框选要识别的区域　·　Esc 取消" />
        </Border>
    </Canvas>
</Window>
